# LBank API
LBANK_API_KEY=c53a166f-421b-4743-bfdd-4e49a1c6f24a
LBANK_API_
LBANK_BASE_URL=https://fapi.lbank.info
LBANK_SIGN_METHOD=RSA

# Webhook Security
WEBHOOK_SECRET=bridge-tokyo
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8002

# Monitor Loop Configuration
MONITOR_POLL_INTERVAL_SECONDS=0.5

# Trade Defaults
DEFAULT_TRADE_SIZE_USD=100
PARTIAL_EXIT_FRACTION=0.5

# Signal Evaluation
SIGNAL_EVAL_DELAY_MINUTES=0
CCXT_EXCHANGE_SOURCE=binance
CANDLE_TIMEFRAME=15m
SLOPE_METHOD=ema_slope
USE_DELTA_EMA=true
DELTA_NTZ=5.0
CANDLE_FETCH_LIMIT=1500
USE_ATR_REGIME=false
ATR_LENGTH=14
ATR_EMA_LENGTH=20
ATR_FAST_THRESHOLD=20.0
ATR_TIMEFRAME=5m
ATR_CANDLE_LIMIT=1500

# EMA Calibration & Tuning
EMA_MACRO_SPAN=120
SLOPE_SMOOTH_BARS=7
DELTA_SMOOTH_BARS=3
EMA_CALIBRATION_BASE=50
EMA_CALIBRATION_FACTOR=10.0
VZ_MEMORY_BARS=20
SL_BUFFER_PCT=0.5

# Execution Tuning
MIN_CLOSE_NOTIONAL_USD=90.0
SL_MAX_RETRIES=3

# Trade Manager Execution Thresholds
TRADE_INITIAL_SL_PCT=2.0
TRADE_BE_TRIGGER_PCT=0.6
TRADE_TP1_TRIGGER_PCT=0.9
TRADE_TRAIL_ACTIVE_PCT=1.5
TRADE_TRAIL_LOCK_PCT=0.9
TRADE_TP2_TRIGGER_PCT=2.5

# Pre-Execution Filters
MAX_EMA_GAP_PCT=4.0
MIN_EMA_GAP_PCT=0.3
MAX_CHASE_PCT=0.5
CHASE_ACTION=half_size

# Counter-Trend Override
ALLOW_COUNTER_TREND_HALF_SIZE=true

# Memory Halt
MEMORY_POLL_INTERVAL_TICKS=120

# Dynamic Slope Stop-Loss
ENABLE_SLOPE_SL=true
OPPOSITE_SLOPE_THRESHOLD=-2.0
SLOPE_SL_CHECK_INTERVAL_TICKS=120
SIGNAL_COOLDOWN_MINUTES=5

# Queue Management
SIGNAL_STALE_TTL_MINUTES=60

# Telegram Notifications
BEAST_TELEGRAM_TOKEN=8613840045:AAGwZJ85i05UMp6XosKgHu-rIAwHRIFAEkc
BEAST_TELEGRAM_CHAT_ID=-1003820031428
TELEGRAM_ENABLED=true

# Account Snapshots
SNAPSHOT_INTERVAL_HOURS=24

# Process Mode
